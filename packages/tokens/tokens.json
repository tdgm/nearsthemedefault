        "value": "{color.brand.300}"
      },
      "price": {
        "value": "{color.neutral.50}"
      },
      "price-sale": {
        "value": "{color.accent.300}"
      },
      "price-list": {
        "value": "{color.neutral.400}"
      },
      "badge-promo-bg": {
        "value": "{color.accent.600}"
      },
      "badge-promo-on": {
        "value": "{color.neutral.0}"
