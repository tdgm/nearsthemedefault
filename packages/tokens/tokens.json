  "typography": {
    "font": {
      "brand": {
        "source": {
          "value": "system",
          "note": "self-hosted | system. 'system' = zero download, usa typography.family.system. Default atual: system, ate o woff2 da fonte ser adicionado em packages/tokens/fonts/ (ver docs/adr/0011)"
        },
        "name": {
          "value": "Inter",
          "note": "qualquer familia variavel open source; lista curada em docs/adr/0001-tipografia-open-source.md"
        },
        "license": {
          "value": "OFL-1.1",
          "note": "OFL-1.1 | Apache-2.0. O build falha com qualquer outra licenca"
        },
        "file": {
          "value": "fonts/brand-variable.woff2",
          "note": "woff2 variavel, subset latin + latin-ext, eixo wght recortado em 400-700"
        },
        "fallback": {
          "value": "Arial",
          "note": "Arial | Times New Roman (serifada). Fonte local usada para calcular size-adjust e evitar CLS"
        }
      }
    },
    "family": {
      "brand": {
        "value": "var(--font-brand, {typography.family.system})",
        "note": "--font-brand e emitida pelo loader (next/font/local) com o fallback calibrado incluido"
      },
      "system": {
        "value": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', 'Liberation Sans', sans-serif",
        "note": "pilha websafe: existe em Windows, macOS, iOS, Android e Linux sem download"
      },
      "mono": {
        "value": "ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace"
      }
    },
    "fallbackMetrics": {
      "strategy": {
        "value": "auto",
        "note": "size-adjust, ascent, descent e line-gap calculados no build pelo next/font/local (adjustFontFallback) contra typography.font.brand.fallback. Nao calibrar a mao"
      }
    },
    "weight": {
      "regular": {
        "value": 400
      },
      "medium": {
        "value": 500
      },
      "bold": {
        "value": 700
      }
    },
