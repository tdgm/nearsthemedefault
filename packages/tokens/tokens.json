      },
      "on-surface-faint": {
        "value": "{color.neutral.400}"
      },
      "on-inverse": {
        "value": "{color.neutral.900}"
      },
      "border": {
        "value": "{color.neutral.700}",
        "note": "decorativa. Nunca como unico limite de um controle"
      },
      "border-strong": {
        "value": "{color.neutral.600}",
        "note": "decorativa. Nunca como unico limite de um controle"
      },
      "border-control": {
        "value": "{color.neutral.400}"
