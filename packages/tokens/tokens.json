  "semantic": {
    "$note": "Os dois temas declaram exatamente as mesmas chaves (sem heranca implicita). Contrastes nao sao anotados aqui: sao calculados por pnpm tokens:contrast a partir de contracts.yaml > gates.accessibility.contrastPairs.",
    "light": {
      "surface": {
        "value": "{color.neutral.0}"
      },
      "surface-subtle": {
        "value": "{color.neutral.50}"
      },
      "surface-raised": {
        "value": "{color.neutral.0}"
      },
      "surface-inverse": {
        "value": "{color.neutral.900}"
      },
      "on-surface": {
        "value": "{color.neutral.900}"
      },
      "on-surface-muted": {
        "value": "{color.neutral.600}"
      },
      "on-surface-faint": {
        "value": "{color.neutral.500}"
      },
      "on-inverse": {
        "value": "{color.neutral.0}"
      },
      "border": {
        "value": "{color.neutral.200}",
        "note": "decorativa (divisores, cards). Nunca como unico limite de um controle"
      },
      "border-strong": {
        "value": "{color.neutral.300}",
        "note": "decorativa com mais enfase. Nunca como unico limite de um controle"
      },
      "border-control": {
        "value": "{color.neutral.500}",
        "note": "limite de input, select, checkbox, radio e variante: >= 3:1 (WCAG 1.4.11)"
      },
      "focus-ring": {
        "value": "{color.brand.600}"
      },
      "action": {
        "value": "{color.neutral.900}"
      },
      "action-hover": {
        "value": "{color.neutral.1000}"
      },
      "action-on": {
        "value": "{color.neutral.0}"
      },
      "link": {
        "value": "{color.brand.600}"
      },
      "price": {
        "value": "{color.neutral.900}"
      },
      "price-sale": {
        "value": "{color.accent.700}"
      },
      "price-list": {
        "value": "{color.neutral.500}"
      },
      "badge-promo-bg": {
        "value": "{color.accent.600}"
      },
      "badge-promo-on": {
        "value": "{color.neutral.0}"
      },
      "success": {
        "value": "{color.status.success}"
      },
      "warning": {
        "value": "{color.status.warning}"
      },
      "danger": {
        "value": "{color.status.danger}"
      },
      "info": {
        "value": "{color.status.info}"
      }
