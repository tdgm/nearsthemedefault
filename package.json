{
  "name": "nearsthemedefault",
  "private": true,
  "version": "1.0.0",
  "description": "Template padrao white-label da plataforma Nears.",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "eslint .",
    "typecheck": "pnpm --filter web typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:a11y": "concurrently -k -s first -n SB,TEST \"npx http-server storybook-static --port 6006 --silent\" \"npx wait-on tcp:6006 && test-storybook --url http://127.0.0.1:6006\"",
    "test:nojs": "playwright test --project=nojs",
    "lh": "lhci autorun",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "manifests:validate": "node scripts/validate-manifests.mjs",
    "tokens:contrast": "node scripts/validate-tokens-contrast.mjs",
    "validate": "pnpm lint && pnpm typecheck && pnpm manifests:validate && pnpm tokens:contrast && pnpm audit --audit-level=high && pnpm build && node scripts/check-budgets.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.0.0",
    "@eslint/eslintrc": "^3.2.0",
    "prettier": "^3.4.0",
    "vitest": "^2.1.8",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@playwright/test": "^1.49.0",
    "@axe-core/playwright": "^4.10.1",
    "storybook": "^8.4.7",
    "@storybook/nextjs": "^8.4.7",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-a11y": "^8.4.7",
    "@storybook/test-runner": "^0.19.1",
    "concurrently": "^9.1.0",
    "http-server": "^14.1.1",
    "wait-on": "^8.0.1",
    "@lhci/cli": "^0.14.0",
    "yaml": "^2.6.1"
  }
}
