{
  "name": "nearsthemedefault",
  "version": "0.1.0",
  "private": true,
  "description": "Template padrao white-label da plataforma Nears",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:nojs": "playwright test --project=nojs",
    "test:e2e:presets": "node --disable-warning=ExperimentalWarning scripts/test-e2e-presets.mjs",
    "test:a11y": "node scripts/test-a11y.mjs",
    "lh": "lhci autorun",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "manifests:validate": "node --disable-warning=ExperimentalWarning scripts/manifests-validate.mjs",
    "manifests:types": "node --disable-warning=ExperimentalWarning scripts/manifests-types.mjs",
    "manifests:check": "node --disable-warning=ExperimentalWarning scripts/manifests-types.mjs --check",
    "tokens:contrast": "node scripts/tokens-contrast.mjs",
    "tokens:build": "pnpm --filter @nears/tokens build",
    "tokens:check": "pnpm --filter @nears/tokens check",
    "check-budgets": "node scripts/check-budgets.mjs",
    "check-ui-bundle": "node scripts/check-ui-bundle.mjs",
    "validate": "pnpm lint && pnpm typecheck && pnpm manifests:validate && pnpm manifests:check && pnpm tokens:check && pnpm tokens:contrast && pnpm test && pnpm build && pnpm check-budgets && pnpm check-ui-bundle"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-essentials": "8.6.19",
    "@storybook/react": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@storybook/test": "8.6.19",
    "@storybook/test-runner": "^0.26",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-playwright": "^2.2.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "globals": "^17.14.0",
    "http-server": "^14.1.1",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "storybook": "10.6.6",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "overrides": {
      "basic-ftp": ">=6.2.1",
      "minimatch": ">=11.0.1",
      "glob@>=9.0.0 <=14.0.1": ">=14.0.2",
      "uuid@<11.1.1": ">=11.1.1"
    }
  }
}
